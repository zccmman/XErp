# 飞书自建应用凭据 (开放平台 -> 应用凭证), 本文件可入库, .env 不入库
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 审批卡片接收人 open_id, 由 scripts/feishu_ws.py 的「绑定」流程自动写入
FEISHU_RECEIVE_OPEN_ID=

# 可选云端 JEV 校准后端（TypeSafe Jev · 默认关闭，不配置则纯本地）。
# 仅当用户在 Web 显式开启「云端模式」并确认数据出境授权后才启用；
# 密钥仅来自本地 .env（不入库、不硬编码）。配置后才允许账套级开启云端校准。
TYPESAFE_API_KEY=
